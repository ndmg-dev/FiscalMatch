# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=fiscalmatch
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Redis
REDIS_URL=redis://redis:6379/0

# MinIO
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=minio:9000
MINIO_BUCKET=fiscalmatch

# Backend
API_V1_STR=/api/v1
SECRET_KEY=supersecretkey

# Mesmo valor de JWT_SECRET do backend-fastapi do CRM — autentica as chamadas
# do frontend nativo embutido lá (src/systems/conciliacao-fiscal).
JWT_SECRET=
# Origens permitidas para CORS, separadas por vírgula.
CORS_ORIGINS=http://localhost:3000,https://crmmg.mendoncagalvao.com.br

# SIEG (Placeholder for Phase 2)
SIEG_API_KEY=
SIEG_API_URL=https://api.sieg.com/
